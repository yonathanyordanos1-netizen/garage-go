{
  "expo": {
    "name": "Garage Go",
    "slug": "garage-go",
    "version": "1.0.0",
    "scheme": "garagego",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#5C3A21"
    },
    "splash": {
      "backgroundColor": "#5C3A21"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.garagego.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.garagego.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5C3A21"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1c013ae-52d2-4d1c-b36f-88de2774615d"
      }
    },
    "owner": "yonathan-tech"
  }
}
