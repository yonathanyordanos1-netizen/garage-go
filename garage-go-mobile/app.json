{
  "expo": {
    "name": "Garage Go",
    "slug": "garage-go",
    "version": "1.0.0",
    "scheme": "garagego",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#3A2A1D",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.garagego.app"
    },
    "android": {
      "package": "com.garagego.app",
      "adaptiveIcon": {
        "backgroundColor": "#3A2A1D"
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
